# ============================================
# SSC Election Management System - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================
# Application
# ============================================
APP_NAME="SSC Election Management"
APP_ENV=development
# Options: development, production
FORCE_HTTPS=false
# Set to true to force HTTPS redirects

# ============================================
# Database
# ============================================
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# ============================================
# Session
# ============================================
SESSION_ENCRYPTION_KEY="your-encryption-key-here"
# Generate with: base64_encode(random_bytes(32))
SESSION_LIFETIME=1800
# Session lifetime in seconds (30 minutes)
SESSION_GC_MAXLIFETIME=2100
# Garbage collection max lifetime (35 minutes)
SESSION_COOKIE_LIFETIME=2100
# Cookie lifetime in seconds (35 minutes)

# ============================================
# Security
# ============================================
CSRF_TOKEN_LENGTH=32
NONCE_LENGTH=32

# ============================================
# Cron Webhook
# ============================================
CRON_WEBHOOK_TOKEN="your-cron-webhook-token"
# Used to authenticate cron_webhook.php requests

# ============================================
# Rate Limiting
# ============================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30
# Lockout duration in seconds

# ============================================
# Cloudflare Turnstile
# ============================================
# Get keys from: https://dash.cloudflare.com/
TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ============================================
# SMTP Configuration
# ============================================
SMTP_HOST="smtp.yourdomain.com"
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_ENCRYPTION=tls
# Options: tls, ssl, none
SMTP_PORT=587
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="SSC Election Management"

# ============================================
# SendGrid Configuration
# ============================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="SSC Election Management"